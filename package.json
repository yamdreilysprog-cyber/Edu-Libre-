{
  "name": "edulibre-api",
  "version": "1.0.0",
  "description": "Backend API para Edulibre - Portal educativo venezolano",
  "main": "app/api/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch app/api app/api/index.js",
    "dev:frontend": "cd app/client/superior-singularity && npm run dev",
    "build": "cd app/client/superior-singularity && npm install && npm run build",
    "start": "node -r dotenv/config app/api/index.js",
    "test": "jest --runInBand",
    "db:seed": "node app/api/db/seed.js"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@supabase/supabase-js": "^2.108.0",
    "astro": "^6.4.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/app/api/tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ]
  }
}
