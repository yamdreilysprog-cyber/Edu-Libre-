---
export interface Props {
  role: 'estudiante' | 'institucion' | 'admin';
  active: string; // ej: 'panel', 'favoritos', 'dashboard', 'aprobaciones'...
}
const { role, active } = Astro.props;

const icons: Record<string, string> = {
  grid: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/>',
  check: '<path d="m20 6-11 11-5-5"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  catalog: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>',
  edit: '<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/>',
  card: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="18" cy="9" r="2.6"/><path d="M15 20a5 5 0 0 1 7.5-4.3"/>',
  taxonomy: '<path d="M4 6h16M4 12h10M4 18h6"/>',
};

type Link = { href: string; key: string; label: string; icon: string };

const linksByRole: Record<string, Link[]> = {
  estudiante: [
    { href: '/estudiante/panel', key: 'panel', label: 'Mi panel', icon: 'grid' },
    { href: '/estudiante/favoritos', key: 'favoritos', label: 'Favoritos', icon: 'heart' },
    { href: '/estudiante/verificacion', key: 'verificacion', label: 'Verificación', icon: 'check' },
  ],
  institucion: [
    { href: '/institucion/dashboard', key: 'dashboard', label: 'Dashboard', icon: 'grid' },
    { href: '/institucion/catalogo', key: 'catalogo', label: 'Catálogo', icon: 'catalog' },
    { href: '/institucion/editor-sitio', key: 'editor-sitio', label: 'Configuración de perfil', icon: 'edit' },
    { href: '/institucion/estadisticas', key: 'estadisticas', label: 'Estadísticas', icon: 'chart' },
  ],
  admin: [
    { href: '/admin/dashboard', key: 'dashboard', label: 'Dashboard', icon: 'grid' },
    { href: '/admin/aprobaciones', key: 'aprobaciones', label: 'Aprobaciones', icon: 'check' },
    { href: '/admin/auditoria', key: 'auditoria', label: 'Auditoría de contenido', icon: 'search' },
    { href: '/admin/usuarios', key: 'usuarios', label: 'Usuarios', icon: 'users' },
    { href: '/admin/taxonomias', key: 'taxonomias', label: 'Taxonomías', icon: 'taxonomy' },
  ],
};

const sectionLabel: Record<string, string> = {
  estudiante: 'Estudiante',
  institucion: 'Institución',
  admin: 'Administración',
};

const links = linksByRole[role];
---
<aside class="sidebar">
  <div class="sidebar__logo"><a href="/" style="color:inherit;text-decoration:none;display:inline-block;cursor:pointer;">Edu<span>Libre</span></a></div>
  <div class="sidebar__section">{sectionLabel[role]}</div>
  {links.map(link => (
    <a href={link.href} class={`sidebar__link ${active === link.key ? 'active' : ''}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons[link.icon]} />
      {link.label}
    </a>
  ))}

  {role === 'estudiante' && (
    <>
      <div class="sidebar__section">General</div>
      <a href="/results" class="sidebar__link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons.search} />Explorar</a>
    </>
  )}
  {role === 'institucion' && (
    <>
      <div class="sidebar__section">General</div>
      <a href="/planes" class="sidebar__link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons.card} />Mi plan</a>
    </>
  )}

  <div class="sidebar__foot"><a href="/login" class="sidebar__link" style="margin:0;">Cerrar sesión</a></div>
</aside>
