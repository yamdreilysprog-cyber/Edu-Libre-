---
import AppShellLayout from '../../layouts/AppShellLayout.astro';
---
<AppShellLayout
  title="Gestión de usuarios — EduLibre"
  pageTitle="Usuarios"
  role="admin"
  active="usuarios"
  userInitials="AD"
  userLabel="Admin"
>
<div data-tabs="" style="display:flex;gap:6px;margin-bottom:18px;background:var(--paper-dim);padding:4px;border-radius:999px;width:fit-content;">
<button class="active" data-tab="est" style="border:none;background:#fff;padding:8px 18px;border-radius:999px;font-size:13.5px;font-weight:600;box-shadow:0 2px 6px rgba(20,33,61,.08);">Estudiantes</button>
<button data-tab="inst" style="border:none;background:transparent;padding:8px 18px;border-radius:999px;font-size:13.5px;color:var(--muted);">Instituciones</button>
</div>
<div data-tab-panel="est">
<div class="table-wrap">
<table>
<thead><tr><th>Nombre</th><th>Correo</th><th>Registrado</th><th>Estado</th><th></th></tr></thead>
<tbody>
<tr><td>María González</td><td>maria.g@correo.com</td><td>Hace 2 semanas</td><td><span class="badge badge--approved">Verificado</span></td><td><button class="btn btn--ghost btn--sm">Ver</button></td></tr>
<tr><td>Jesús Pérez</td><td>jesus.p@correo.com</td><td>Hace 3 días</td><td><span class="badge badge--pending">Sin verificar</span></td><td><button class="btn btn--ghost btn--sm">Ver</button></td></tr>
<tr><td>Andrea Rojas</td><td>andrea.r@correo.com</td><td>Hoy</td><td><span class="badge badge--pending">Sin verificar</span></td><td><button class="btn btn--ghost btn--sm">Ver</button></td></tr>
</tbody>
</table>
</div>
</div>
<div data-tab-panel="inst" style="display:none;">
<div class="table-wrap">
<table>
<thead><tr><th>Institución</th><th>Tipo</th><th>Carreras publicadas</th><th>Estado</th><th></th></tr></thead>
<tbody>
<tr><td>Universidad Simón Bolívar</td><td>Universidad</td><td>18</td><td><span class="badge badge--approved">Activa</span></td><td><button class="btn btn--ghost btn--sm">Ver</button></td></tr>
<tr><td>UCAB</td><td>Universidad</td><td>22</td><td><span class="badge badge--approved">Activa</span></td><td><button class="btn btn--ghost btn--sm">Ver</button></td></tr>
<tr><td>Academia Digital Venezuela</td><td>Academia</td><td>0</td><td><span class="badge badge--pending">Pendiente</span></td><td><button class="btn btn--ghost btn--sm">Ver</button></td></tr>
</tbody>
</table>
</div>
</div>
</AppShellLayout>
